# Base de datos (Neon Postgres) — copia la "Connection string" del panel de Neon.
# Debe incluir ?sslmode=require al final.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/xilotcode?sslmode=require"

# Autenticación
# Genera un valor aleatorio y largo, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Usuario administrador que crea "npm run seed" (nunca se guarda en texto plano en la BD)
ADMIN_EMAIL=admin@xilotcode.com
ADMIN_PASSWORD=
ADMIN_NAME="Administrador XilotCode"

# Cloudinary (almacenamiento de imágenes de proyectos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes permitidos por CORS. Uno o varios separados por coma
# (útil para agregar la URL de previews de Vercel además del dominio final).
FRONTEND_URL=http://localhost:5173

PORT=4000
NODE_ENV=development
