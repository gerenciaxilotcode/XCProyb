generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  secureUrl String
  format    String?
  width     Int?
  height    Int?
  bytes     Int?
  altText   String?
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeHeroes          HomeHero[]
  brandLogos          BrandSettings[]  @relation("BrandLogo")
  brandFavicons       BrandSettings[]  @relation("BrandFavicon")
  sectors             Sector[]
  services            Service[]
  differentiators     Differentiator[]
  offers              Offer[]
}

model HomeHero {
  id                String   @id @default("main")
  eyebrow           String
  title             String
  subtitle          String
  ctaPrimaryLabel   String
  ctaSecondaryLabel String
  tagline           String
  imageAssetId      String?
  imageAsset        MediaAsset? @relation(fields: [imageAssetId], references: [id])
  updatedAt         DateTime @updatedAt
}

model CtaBlock {
  id          String   @id @default("main")
  title       String
  description String
  buttonLabel String
  updatedAt   DateTime @updatedAt
}

model BrandSettings {
  id             String   @id @default("main")
  name           String
  tagline        String
  description    String
  logoAssetId    String?
  logoAsset      MediaAsset? @relation("BrandLogo", fields: [logoAssetId], references: [id])
  faviconAssetId String?
  faviconAsset   MediaAsset? @relation("BrandFavicon", fields: [faviconAssetId], references: [id])
  updatedAt      DateTime @updatedAt
}

model ContactInfo {
  id              String   @id @default("main")
  phone           String?
  email           String?
  whatsappNumber  String
  whatsappMessage String?
  address         String?
  schedule        String?
  instagramUrl    String?
  facebookUrl     String?
  linkedinUrl     String?
  updatedAt       DateTime @updatedAt
}

model ProcessStep {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  order       Int      @default(0)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  key           String   @unique
  title         String
  description   String
  iconKey       String
  imageAssetId  String?
  imageAsset    MediaAsset? @relation(fields: [imageAssetId], references: [id])
  order         Int      @default(0)
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Sector {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  imageAssetId  String?
  imageAsset    MediaAsset? @relation(fields: [imageAssetId], references: [id])
  order         Int      @default(0)
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Differentiator {
  id            String   @id @default(cuid())
  key           String   @unique
  title         String
  description   String
  iconKey       String
  imageAssetId  String?
  imageAsset    MediaAsset? @relation(fields: [imageAssetId], references: [id])
  order         Int      @default(0)
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([active])
}

model Offer {
  id           String    @id @default(cuid())
  title        String
  description  String
  priceText    String?
  ctaLabel     String?
  ctaLink      String?
  imageAssetId String?
  imageAsset   MediaAsset? @relation(fields: [imageAssetId], references: [id])
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean   @default(false)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
}

enum ContactStatus {
  NEW
  READ
  CONTACTED
  ARCHIVED
}

enum ProjectType {
  WEBSITE
  ADMIN_SYSTEM
  ONLINE_STORE
  CUSTOM_APP
  AUTOMATION
  OTHER
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  business    String?
  email       String
  phone       String?
  projectType ProjectType
  budget      String?
  message     String
  status      ContactStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}
